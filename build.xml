<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="build_jar" name="Create all Jars for Project LanguagePropertiesManager">
	<property name="commons-collections4.version" value="4.4" />
	<property name="commons-compress.version" value="1.24.0" />
	<property name="commons-io.version" value="2.14.0" />
	<property name="log4j.version" value="2.20.0" />
	<property name="poi.version" value="5.2.4" />
	<property name="xmlbeans.version" value="5.1.1" />
	<property name="commons-lang3.version" value="3.11" />
	<property name="commons-text.version" value="1.9" />
	<property name="mailapi.version" value="2.0.1" />
	<property name="jna.version" value="5.6.0" />
	<property name="csv.version" value="26.1.1" />
	<property name="json.version" value="26.2.1" />
	<property name="proxyautoconfig.version" value="26.1.0" />
	<property name="network.version" value="26.0.27" />
	<property name="soderer-utilities.version" value="26.2.39" />

	<property name="swt.version" value="4.38" />
	<property name="swt.build" value="R-4.38-202512010920" />

	<target name="build_jar" depends="build_setup, cleanup_before, create_jar, cleanup_after" />

	<target name="probe-proxy">
		<condition property="proxy.enabled">
			<and>
				<isset property="proxy.host" />
				<isreachable host="${proxy.host}" />
			</and>
		</condition>
	</target>

	<target name="proxy" depends="probe-proxy" if="proxy.enabled">
		<property name="proxy.port" value="80" />
		<property name="proxy.user" value="" />
		<property name="proxy.pass" value="" />
		<setproxy proxyhost="${proxy.host}" proxyport="${proxy.port}" proxyuser="${proxy.user}" proxypassword="${proxy.pass}" />
	</target>

	<target name="build_setup">
		<echo>Java/JVM HOME: ${java.home}</echo>
		<echo>Java/JVM version: ${ant.java.version}</echo>
		<echo>Java/JVM detailed version: ${java.version}</echo>

		<loadfile property="build.version" srcFile="build.version" failonerror="false" />
		<property name="build.version" value="26.0.0" />
		<echo message="build.version: ${build.version}" />

		<!-- Default: https://soderer.de/index.php?download=Versions.json -->
		<!-- Override for GitHub: https://api.github.com/repos/hudeany/LanguagePropertiesManager/releases/latest -->
		<property name="VersionsUrl" value = "https://api.github.com/repos/hudeany/LanguagePropertiesManager/releases/latest" />
		<property file="${user.home}/git/codeSigning.properties" />

		<property environment="env"/>

		<tstamp>
			<format property="buildTime" pattern="yyyy-MM-dd HH:mm:ss" locale="en" />
		</tstamp>
		<echo message="buildTime: ${buildTime}" />

		<property file="${user.home}/git/codeSigning.properties" />

		<property name="buildPath" value="build" />
		<echo message="buildPath: ${buildPath}" />
	</target>

	<target name="cleanup_before">
		<delete dir="${buildPath}" />
		<mkdir dir="${buildPath}" />
		<mkdir dir="${buildPath}/bin" />
	</target>

	<available file="lib/commons-collections4-${commons-collections4.version}.jar" property="commons-collections4.available" />
	<target name="get_commons_collections4" unless="commons-collections4.available" depends="proxy">
		<mkdir dir="lib/" />
		<delete>
			<fileset dir="lib" includes="commons-collections4-*.jar" />
		</delete>
		<get src="https://repo1.maven.org/maven2/org/apache/commons/commons-collections4/${commons-collections4.version}/commons-collections4-${commons-collections4.version}.jar" dest="lib/" />
	</target>

	<available file="lib/commons-compress-${commons-compress.version}.jar" property="commons-compress.available" />
	<target name="get_commons_compress" unless="commons-compress.available" depends="proxy">
		<mkdir dir="lib/" />
		<delete>
			<fileset dir="lib" includes="commons-compress-*.jar" />
		</delete>
		<get src="https://repo1.maven.org/maven2/org/apache/commons/commons-compress/${commons-compress.version}/commons-compress-${commons-compress.version}.jar" dest="lib/" />
	</target>

